
<%- include('../partials/head', { title: 'Courses' }) %>

<%- include('../partials/header') %>

<main class="container">

    <h1>Explore Our Courses</h1>

    <p>Find the right course to build your future.</p>

    <!-- Search and Filter -->
    <form action="/courses" method="GET" class="search-filter">

        <input
            type="text"
            name="search"
            placeholder="Search courses..."
            value="<%= search %>"
        >

        <select name="category">

            <option value="All"
                <%= selectedCategory === "All" ? "selected" : "" %>>
                All Categories
            </option>

            <% categories.forEach(category => { %>

                <option value="<%= category %>"
                    <%= selectedCategory === category ? "selected" : "" %>>
                    <%= category %>
                </option>

            <% }) %>

        </select>

        <button type="submit" class="btn">
            Search
        </button>

        <a href="/courses" class="reset-btn">
            Reset
        </a>

    </form>

    <!-- Course Cards -->
    <div class="course-container">

        <% if (courses.length > 0) { %>

            <% courses.forEach(course => { %>

                <%- include('../partials/course-card', { course: course }) %>

            <% }) %>

        <% } else { %>

            <div class="no-results">
                <h3>No courses found!</h3>
                <p>Try another course name or category.</p>
            </div>

        <% } %>

    </div>

</main>

<%- include('../partials/footer') %>
